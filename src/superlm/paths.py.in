import os
from pathlib import Path

import dotenv

dotenv.load_dotenv()
path = os.getenv("WORKSPACE_PATH")
if path is None:
    path = "workspace"
    dotenv.set_key(".env", "WORKSPACE_PATH", path)

WORKSPACE_PATH = Path(path)
CHECKPOINTS_PATH = WORKSPACE_PATH / ".checkpoints"
CHECKPOINTS_PATH.mkdir(parents=True, exist_ok=True)


class Paths:
    def __init__(self, space_name: str, model_name: str = "model") -> None:
        self.root = WORKSPACE_PATH / space_name
        self.root.mkdir(exist_ok=True)
        self.space_name = space_name
        self.model_name = model_name
        root = self.root
        input = "inputs"
        model = f"models--{self.model_name}"
        ${code}
