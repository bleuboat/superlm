from collections.abc import Iterator, MutableMapping
from types import UnionType
from typing import Any, Never, NotRequired, Self, TypedDict, Unpack

from .activations import ACTIVATIONS


class Parameter:
    __slots__ = ("annotation", "default", "value")
    __sentinel = object()

    def __init__(self, annotation: type | UnionType, default: Any) -> None:
        self.value = self.__sentinel
        self.annotation = annotation
        if callable(default):
            self.default = default
        else:
            self.default = lambda: default

    def get(self) -> Any:
        if self.value is self.__sentinel:
            return self.default()
        return self.value

    def __repr__(self) -> str:
        return f"Parameter({self.get()})"


class Config(MutableMapping[str, Any]):
    _data: dict[str, Parameter]

    def __init__(self) -> None:
        super().__setattr__("_data", {})

    def __setitem__(self, key: str, value: Any) -> None:
        self._data[key].value = value

    def __getitem__(self, key: str) -> Any:
        return self._data[key].get()

    def __delitem__(self, key: str) -> Never:
        raise NotImplementedError("don't delete config's items")

    def __setattr__(self, key: str, value: Any) -> None:
        self[key] = value

    def __getattr__(self, key: str) -> Any:
        return self[key]

    def __len__(self) -> int:
        return self._data.__len__()

    def __iter__(self) -> Iterator[str]:
        return self._data.__iter__()

    def __contains__(self, key: Any) -> bool:
        return self._data.__contains__(key)

    def __str__(self) -> str:
        return f"{type(self).__name__}(\n  {",\n  ".join(f"{k}={self[k]}" for k in self)},\n)"

    def __repr__(self) -> str:
        return f"{type(self).__name__}({", ".join(f"{k}={self[k]!r}" for k in self)})"

    def __call__(self, *keys: str, **configs: Unpack[AllConfigTypedDict]) -> tuple[Any] | None:
        if keys and configs:
            raise RuntimeError
        if keys:
            return self._get(keys)
        if configs:
            return self._set(configs)
        return None

    def _get(self, keys: tuple[str, ...]) -> tuple[Any]:
        out: list[Any] = []
        for k in keys:
            out.append(self[k])
        return tuple(out)

    def _set(self, configs: AllConfigTypedDict) -> None:
        for k in configs:
            self[k] = configs[k]
        self.check()

    def _check_params(self) -> None:
        for name, param in self._data.items():
            annotation = param.annotation
            if not isinstance(param.get(), annotation):
                if isinstance(annotation, UnionType):
                    types = annotation.__args__
                else:
                    types = (annotation.__name__,)
                raise TypeError(
                    f"'{name}' must be {" or ".join(f"a {type}" for type in types)}, "
                    f"got {type(param.get()).__name__}",
                )

    def _check_extras(self) -> None:
        return

    def check(self) -> None:
        self._check_params()
        self._check_extras()

    def copy(self) -> Self:
        out = type(self)()
        for k, v in self._data.items():
            out[k] = v.value
        return out


class ConfigGroupBase(MutableMapping[str, Config]):
    _data: dict[str, Config]

    def __init__(self) -> None:
        super().__setattr__("_data", {})

    def __setitem__(self, key: str, value: Any) -> None:
        self._data[key] = value

    def __getitem__(self, key: str) -> Any:
        return self._data[key]

    def __delitem__(self, key: str) -> Never:
        raise NotImplementedError("don't delete config's items")

    def __setattr__(self, key: str, value: Any) -> None:
        self._data[key] = value

    def __getattr__(self, key: str) -> Any:
        return self._data[key]

    def __len__(self) -> int:
        return self._data.__len__()

    def __iter__(self) -> Iterator[str]:
        return self._data.__iter__()

    def __contains__(self, key: Any) -> bool:
        return self._data.__contains__(key)

    def __str__(self) -> str:
        return f"{type(self).__name__}(\n  {",\n  ".join(f"{k}={self[k]}" for k in self)},\n)"

    def __repr__(self) -> str:
        return f"{type(self).__name__}({", ".join(f"{k}={self[k]!r}" for k in self)})"

    def __call__(self, *keys: str, **configs: Unpack[AllConfigTypedDict]) -> tuple[Any] | None:
        if keys and configs:
            raise RuntimeError
        if keys:
            return self._get(keys)
        if configs:
            return self._set(configs)
        return None

    def _get(self, keys: tuple[str, ...]) -> tuple[Any]:
        out: list[Any] = []
        for k in keys:
            for config in self.values():
                if k in config:
                    out.append(config[k])
                    break
            else:
                raise KeyError(k)
        return tuple(out)

    def _set(self, configs: AllConfigTypedDict) -> None:
        for k in configs:
            for config in self.values():
                if k in config:
                    config[k] = configs[k]
                    break
            else:
                raise KeyError(k)
        for config in self.values():
            config.check()


